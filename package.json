{
  "name": "dsh-ag-ui",
  "version": "0.1.0",
  "description": "Authenticated AG-UI HTTP and SSE gateway plugin for DeepSeek Harness",
  "keywords": [
    "ag-ui",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "cordis"
  ],
  "author": "Cai Zongyuan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./browser-tools": {
      "types": "./lib/types/browser-tools.d.ts",
      "default": "./lib/browser-tools.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./dojo-host": "./examples/dojo/dojo-host.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/browser-tools.js",
    "lib/browser-tools.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/invariant.js",
    "lib/invariant.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "cordis.patch.yml",
    "examples/dojo/dojo-host.mjs",
    "examples/dojo/scenario-state.mjs",
    "examples/dojo/scenarios.mjs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaiZongyuan/dsh-ag-ui.git"
  },
  "bugs": {
    "url": "https://github.com/CaiZongyuan/dsh-ag-ui/issues"
  },
  "homepage": "https://github.com/CaiZongyuan/dsh-ag-ui#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "rimraf lib coverage",
    "build:types": "tsc --project tsconfig.json",
    "build:runtime": "tsdown",
    "build": "pnpm clean && pnpm build:types && pnpm build:runtime",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "oxlint src tests examples vitest.config.ts tsdown.config.ts",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "publint": "publint",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm publint",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@ag-ui/core": "~0.0.59",
    "@ag-ui/encoder": "~0.0.59",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@ag-ui/client": "~0.0.59",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@ag-ui/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "~0.0.59",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-util-values": "0.1.5-alpha.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.79.0",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "rxjs": "7.8.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
