{
  "name": "dsh-ag-ui-cards",
  "version": "0.1.0",
  "description": "React renderers for DSH tool view cards carried by dsh:tool:view AG-UI events",
  "keywords": [
    "ag-ui",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "react",
    "components"
  ],
  "author": "Cai Zongyuan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "fixtures/tool-view.events.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaiZongyuan/dsh-ag-ui.git",
    "directory": "packages/dsh-ag-ui-cards"
  },
  "bugs": {
    "url": "https://github.com/CaiZongyuan/dsh-ag-ui/issues"
  },
  "homepage": "https://github.com/CaiZongyuan/dsh-ag-ui/tree/main/packages/dsh-ag-ui-cards#readme",
  "scripts": {
    "clean": "rimraf lib coverage",
    "build:types": "tsc --project tsconfig.json",
    "build:runtime": "tsdown",
    "build": "pnpm clean && pnpm build:types && pnpm build:runtime",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "oxlint src tests fixtures vitest.config.ts tsdown.config.ts",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "publint": "publint",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm publint",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "happy-dom": "20.14.3",
    "oxlint": "1.82.0",
    "publint": "0.3.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
