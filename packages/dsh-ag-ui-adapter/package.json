{
  "name": "dsh-ag-ui-adapter",
  "version": "0.1.0",
  "description": "An AG-UI AbstractAgent that embeds DeepSeek Harness by spawning a loopback micro-host through the dsh-ag-ui gateway",
  "keywords": [
    "ag-ui",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "agent",
    "embedded"
  ],
  "author": "Cai Zongyuan",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/host-boot.js",
    "lib/host-boot.js.map",
    "lib/host-reporter.js",
    "lib/host-reporter.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaiZongyuan/dsh-ag-ui.git",
    "directory": "packages/dsh-ag-ui-adapter"
  },
  "bugs": {
    "url": "https://github.com/CaiZongyuan/dsh-ag-ui/issues"
  },
  "homepage": "https://github.com/CaiZongyuan/dsh-ag-ui/tree/main/packages/dsh-ag-ui-adapter#readme",
  "scripts": {
    "clean": "rimraf lib coverage",
    "build:gateway": "pnpm --filter dsh-ag-ui run build",
    "build:types": "tsc --project tsconfig.json",
    "build:runtime": "tsdown",
    "build": "pnpm clean && pnpm build:types && pnpm build:runtime",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "oxlint src tests fixtures vitest.config.ts tsdown.config.ts",
    "test": "pnpm build:gateway && pnpm build && vitest run",
    "test:coverage": "pnpm build:gateway && pnpm build && vitest run --coverage",
    "publint": "publint",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm publint",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "rxjs": "^7.8.1"
  },
  "peerDependencies": {
    "@ag-ui/client": "~0.0.58",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.1",
    "dsh-ag-ui": "^0.1.0"
  },
  "devDependencies": {
    "@ag-ui/client": "0.0.58",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "dsh-ag-ui": "workspace:*",
    "oxlint": "1.79.0",
    "publint": "0.3.24",
    "rimraf": "6.1.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
